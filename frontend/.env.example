# Copia este archivo como .env (en la carpeta frontend)

# Desarrollo: backend al que Vite reenvía /api
BACKEND_URL=http://localhost:3000

# Producción: dirección pública de la API, por ejemplo https://api.tu-dominio.cl/api
# Déjalo vacío si frontend y API se publican en el mismo dominio y un proxy envía /api al backend.
VITE_API_URL=
