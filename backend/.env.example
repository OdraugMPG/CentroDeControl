# Copia este archivo como .env (en la carpeta backend)
PORT=3000
DATABASE_URL=postgres://usuario:clave@localhost:5432/centro_control
TZ=America/Santiago
# Orígenes del frontend autorizados a llamar a la API, separados por coma
CORS_ORIGIN=http://localhost:5173
# true cuando se publique con https: la cookie de sesión solo viajará cifrada
COOKIE_SECURE=false
